@@ -121,6 +121,10 @@ setup_clang() {
                 CLANG_BRANCH="main-kernel-build-2023"
                 CLANG_REVISION="r487747c"
                 ;;
+            16)
+                CLANG_BRANCH="main-kernel-build-2023"
+                CLANG_REVISION="r487747c"
