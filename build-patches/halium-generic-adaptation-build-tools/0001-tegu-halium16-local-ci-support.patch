From b288c683529267ffdc488795ebf35664384256b7 Mon Sep 17 00:00:00 2001
From: Luke <luke@localhost>
Date: Tue, 3 Nov 2026 12:16:13 +0000
Subject: [PATCH] halium16: local GSI + libhybris overlay

---
 prepare-fake-ota.sh | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/prepare-fake-ota.sh b/prepare-fake-ota.sh
index 89f3af2..2880a80 100644
--- a/prepare-fake-ota.sh
+++ b/prepare-fake-ota.sh
@@ -80,9 +80,14 @@ case "$deviceinfo_halium_version" in
     14)
         DEVICE_GENERIC_URL="$DEVICE_GENERIC_URL_BASE/halium-14.0/lastSuccessfulBuild/artifact/halium_halium_arm64.tar.xz"
         ;;
-    15|16)
+    15)
         DEVICE_GENERIC_URL="$DEVICE_GENERIC_URL_BASE/halium-16.0/lastSuccessfulBuild/artifact/halium_halium_arm64.tar.xz"
         ;;
+    16)
+        # Local halium-16 GSI built from halium-build tree
+        DEVICE_GENERIC_URL="halium_halium_arm64.tar.xz"
+        DEVICE_GENERIC_LOCAL="${HERE}/ota/halium_halium_arm64-16.tar.xz"
+        ;;
     *)
         print_error "Unsupported halium version: '$deviceinfo_halium_version'"
         exit 1
@@ -162,10 +167,22 @@ file="rootfs.tar.xz"
 touch "$OUTPUT/$file.asc"
 echo "update $file $file.asc" >> "$OUTPUT/ubuntu_command"
 
+# libhybris update overlay (halium-16 only)
+LIBHYBRIS_UPDATE="${HERE}/ota/libhybris-16-update.tar.xz"
+if [ "$deviceinfo_halium_version" = "16" ] && [ -f "$LIBHYBRIS_UPDATE" ]; then
+    file="libhybris-16-update.tar.xz"
+    cp "$LIBHYBRIS_UPDATE" "$OUTPUT/$file"
+    touch "$OUTPUT/$file.asc"
+    echo "update $file $file.asc" >> "$OUTPUT/ubuntu_command"
+fi
+
 # Device-generic tarball (Halium GSI)
 file=$(basename "$DEVICE_GENERIC_URL")
 if [ -f "$OUTPUT/$file" ]; then
     print_info "File ("$OUTPUT/$file") already exists, skipping download."
+elif [ -n "$DEVICE_GENERIC_LOCAL" ] && [ -f "$DEVICE_GENERIC_LOCAL" ]; then
+    print_info "Copying local GSI: $DEVICE_GENERIC_LOCAL"
+    cp "$DEVICE_GENERIC_LOCAL" "$OUTPUT/$file"
 else
     download_file "$DEVICE_GENERIC_URL" "$OUTPUT"
 fi
-- 
