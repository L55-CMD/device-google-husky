[Unit]
Description=Husky console snapshot logger (flash-resident diagnostics)
DefaultDependencies=no
After=local-fs.target

[Service]
Type=simple
ExecStart=/bin/sh -c '
  mkdir -p /mnt/husky-dbg;
  mountpoint -q /mnt/husky-dbg || mount -t ext4 /dev/block/by-name/userdata /mnt/husky-dbg 2>/dev/null;
  OUT=/mnt/husky-dbg/husky-console.snap;
  while :; do
    { echo "=== husky snap $(date) ==="; dmesg | tail -250; echo "--- ps ---"; ps; } > "$OUT.tmp" 2>&1 && mv "$OUT.tmp" "$OUT";
    sleep 12;
  done'

[Install]
WantedBy=sysinit.target
