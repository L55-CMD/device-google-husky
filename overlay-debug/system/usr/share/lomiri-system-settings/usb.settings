{
    "plugin": "usb-plugin",
    "name": "USB",
    "icon": "stock_usb",
    "translations": "lomiri-system-settings",
    "category": "hub-internal",
    "priority": 2,
    "keywords": [
        "usb",
        "adb",
        "mtp",
        "rndis",
        "charging",
        "tethering"
