[Unit]
Description=usb-moded rescue SSH server (debug, empty-password)
After=network.target

# Rescue access for debug builds: the phablet account has an empty password
# and this instance only listens on the USB-RNDIS address. Publickey auth
# still works when authorized_keys is present.
[Service]
EnvironmentFile=-/etc/default/ssh
ExecStart=/usr/sbin/sshd -D $SSHD_OPTS \
    -o PasswordAuthentication=yes \
    -o PermitEmptyPasswords=yes \
    -o KbdInteractiveAuthentication=no \
    -o PermitRootLogin=no \
    -o ListenAddress=10.15.19.82:8022
