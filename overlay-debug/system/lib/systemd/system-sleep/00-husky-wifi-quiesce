#!/bin/bash
# 00-husky-wifi-quiesce — systemd sleep hook (pre AND post)
# v2 2026-11-22: ACTIVE quiesce — stage-0 evidence (2026-11-22T16:52Z) proved
# logind suspend on this image does NOT tear Wi-Fi down (the wait-only v1
# always hit its 20 s timeout and dhd then failed suspend: suspend_stats
# fail 0->2, last_failed_dev=0001:01:00.0). P1 proved teardown-BEFORE-suspend
# (nmcli networking off, ~5 s drain) makes suspend enter cleanly.
# Design constraints (Agent 2 review): snapshot user state, restore it after,
# never force-enable what the user disabled, bounded, exit 0 always.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
TAG="husky-sleep-hook"
STATE=/run/husky-sleep-pre-state
log() { echo "$TAG[$1] $2"; logger -t "$TAG" "$1: $2"; }

case "$1" in
pre)
    log pre "start $(date -u +%FT%H:%M:%SZ)"
    # --- snapshot state for post-restore ---
    mkdir -p /run
    {   echo "networking=$(nmcli networking 2>/dev/null)"
        nmcli -t -f DEVICE,TYPE,STATE device | grep -E ':wifi' || true
    } > "$STATE" 2>/dev/null
    log pre "snapshot: $(tr '\n' ' ' < $STATE)"

    # Only quiesce if a managed wifi device is connected.
    if ! nmcli -t -f TYPE,STATE device | grep -q "^wifi:connected"; then
        log pre "no connected wifi; nothing to quiesce"
        exit 0
    fi
    log pre "wifi connected; active quiesce (networking off)"

    nmcli networking off
    # wait for teardown to complete (max 20 s)
    i=0
    while [ $i -lt 20 ]; do
        nmcli -t -f TYPE,STATE device | grep -q "^wifi:connected" || { log pre "teardown complete after ${i}s"; break; }
        sleep 1; i=$((i+1))
    done
    [ $i -ge 20 ] && log pre "WARN: 20s timeout; still connected: $(nmcli -t -f DEVICE,TYPE,STATE device | grep ':wifi:connected' | tr '\n' ' ')"
    # P1-observed busy-state drain after teardown (8 s margin)
    sleep 8
    log pre "quiesce done; handing to suspend $(date -u +%FT%H:%M:%SZ)"
    exit 0
    ;;
post)
    log post "start $(date -u +%FT%H:%M:%SZ)"
    # restore EXACTLY the snapshot: only re-enable networking if it was on.
    if [ -f "$STATE" ]; then
        grep -q "^networking=enabled" "$STATE" && { nmcli networking on; log post "restored networking=on per snapshot"; }
        rm -f "$STATE"
    else
        log post "no snapshot; leaving state untouched"
    fi
    exit 0
    ;;
*)
    exit 0
    ;;
esac
