#!/bin/bash
# 00-husky-wifi-quiesce — systemd sleep hook (pre) [DRY-RUN SAFE]
# Waits for logind-triggered Wi-Fi teardown to settle before kernel suspend.
# Basis: P1 (husky-verify/p1-suspend-20261122/). Never blocks suspend >20s.
# Argument: "pre" (we only act on pre). Exit 0 always.
TAG="husky-sleep-hook"
[ "$1" = "pre" ] || exit 0
log() { echo "$TAG[pre] $*"; logger -t "$TAG" "$*"; }
log "start $(date -u +%FT%H:%M:%SZ)"

# Only act if a managed wifi device was connected/active before suspend.
if ! nmcli -t -f TYPE,STATE device | grep -q "^wifi:connected"; then
    log "no connected wifi; nothing to wait for"
    exit 0
fi
log "wifi connected pre-suspend; waiting for teardown to settle"

# Poll until wifi devices leave connected state (logind PrepareForSleep
# teardown), max 20 s.
i=0
while [ $i -lt 20 ]; do
    if ! nmcli -t -f TYPE,STATE device | grep -q "^wifi:connected"; then
        log "teardown complete after ${i}s"
        break
    fi
    sleep 1
    i=$((i+1))
done
[ $i -ge 20 ] && log "WARN: 20s timeout; suspend proceeds with teardown possibly in flight"

# P1-observed busy-state drain after teardown completes (8 s margin).
sleep 8
log "settle done; handing to suspend $(date -u +%FT%H:%M:%SZ)"
exit 0
