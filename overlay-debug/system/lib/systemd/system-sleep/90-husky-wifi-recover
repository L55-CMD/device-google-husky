#!/bin/bash
# 90-husky-wifi-recover — systemd sleep hook (post) [DRY-RUN SAFE]
# Detects the defect-#12 wedge after resume and auto-heals via NM reset.
# Basis: P4 (husky-verify/p4-suspend-20261122/). NEVER unloads modules.
# Argument: "post" (we only act on post). Exit 0 always.
TAG="husky-sleep-hook"
[ "$1" = "post" ] || exit 0
log() { echo "$TAG[post] $*"; logger -t "$TAG" "$*"; }
log "start $(date -u +%FT%H:%M:%SZ)"
sleep 10   # resume settle: firmware reinit, NM reconnect attempt

healthy=1
# Detector a: iw link must succeed and report Connected (P4 wedge: -19)
if ! iw dev wlan0 link 2>/dev/null | grep -q "Connected"; then
    log "DETECTOR-A FAIL: 'iw dev wlan0 link' not connected"
    healthy=0
fi
# Detector b: ping gateway via wlan0
GW=$(ip -4 route show default dev wlan0 2>/dev/null | awk '{print $3; exit}')
if [ -n "$GW" ]; then
    if ! ping -c 2 -W 3 -I wlan0 "$GW" >/dev/null 2>&1; then
        log "DETECTOR-B FAIL: ping $GW via wlan0 lost"
        healthy=0
    fi
else
    log "DETECTOR-B SKIP: no default route via wlan0"
fi

if [ $healthy -eq 1 ]; then
    log "healthy; no action"
    exit 0
fi

# Wedge -> sanctioned recovery: driver stop/start via NM (P4-proven).
log "WEDGE detected; running NM off/on recovery"
nmcli networking off
sleep 5
nmcli networking on
# Reconnect on this LAN takes ~15-20 s (assoc + 4-way + DHCP); P4 used 15 s.
sleep 22

GW=$(ip -4 route show default dev wlan0 2>/dev/null | awk '{print $3; exit}')
if iw dev wlan0 link 2>/dev/null | grep -q "Connected" || \
   { [ -n "$GW" ] && ping -c 2 -W 3 -I wlan0 "$GW" >/dev/null 2>&1; }; then
    log "recovery OK: wlan0 back online after NM reset"
else
    log "recovery INCOMPLETE: still not connected after NM reset"
fi
log "end $(date -u +%FT%H:%M:%SZ)"
exit 0
